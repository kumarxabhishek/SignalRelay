# Never commit a real secret to this file.
NODE_BINARY=C:\\path\\to\\node.exe
NSE_MCP_ENTRY=C:\\absolute\\path\\to\\SignalRelay\\.vendor\\NSE-MCP\\dist\\index.js

# Vercel API only: calls the private Node bridge instead of spawning Node from
# the Python Function. Keep these unset for direct local stdio MCP usage.
# SIGNALRELAY_NSE_BRIDGE_URL=https://your-api.vercel.app/api/nse-bridge
# SIGNALRELAY_NSE_BRIDGE_TOKEN=set-a-long-random-secret-in-vercel
# SIGNALRELAY_NSE_MCP_ENTRY=/var/task/.vendor/NSE-MCP/dist/index.js

# Optional: required only for verified Phase 3 natural-language explanations.
# ANTHROPIC_API_KEY=

# HTTP adapter: local-safe defaults are 127.0.0.1:8000.
# SIGNALRELAY_HOST=127.0.0.1
# SIGNALRELAY_PORT=8000
# SIGNALRELAY_ALLOWED_ORIGINS=https://your-dashboard.lovable.app
# SIGNALRELAY_API_TOKEN=set-a-long-random-secret-in-your-host
# SIGNALRELAY_ADDITIONAL_API_TOKENS=second-token-for-a-server-side-frontend-proxy
# SIGNALRELAY_RATE_LIMIT=60
# SIGNALRELAY_RATE_WINDOW_SECONDS=60
# NSE_MCP_TIMEOUT_SECONDS=20
# SIGNALRELAY_READINESS_SYMBOL=RELIANCE
